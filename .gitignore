# Rust
/target
**/target
Cargo.lock.bak

# Node / frontend
node_modules
ui/dist
ui/.vite
*.tsbuildinfo

# Tauri build output
src-tauri/target
src-tauri/gen

# Generated runtime data — never commit catalogues, thumbnails, models, photos or secrets
*.db
*.db-wal
*.db-shm
*.sqlite
progress.json
index.log
/appdata
/reports/*.md
!reports/.gitkeep
thumbnails/
models/*.bin
models/*.onnx
models/*.mlmodel
keys/
cache/

# Photographs and media must never be committed
*.jpg
*.jpeg
*.png
*.heic
*.heif
*.tif
*.tiff
*.webp
*.raw
*.cr2
*.nef
*.arw
*.dng
*.mov
*.mp4
# ...except synthetic fixtures explicitly generated for tests
!crates/core/tests/fixtures/**/*.png
!crates/core/tests/fixtures/**/*.jpg

# Secrets
.env
.env.*
*.key
*.pem

# OS
.DS_Store
Thumbs.db

# Editor
.idea
.vscode/*
!.vscode/extensions.json

# Track the source app icon (the full icon set is generated on macOS via
# `cargo tauri icon src-tauri/icons/icon.png` and stays ignored).
!src-tauri/icons/icon.png
src-tauri/icons/*.icns
src-tauri/icons/*.ico
src-tauri/icons/32x32.png
src-tauri/icons/128x128*.png
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png
